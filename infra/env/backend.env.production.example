# Copier vers backend/.env.production dans le dossier prod (/opt/picha-prod) puis remplir.
# Ne jamais committer le fichier rempli. Les valeurs « <...> » sont à renseigner.
# Méthode : partir de backend/.env.staging et ne changer QUE les lignes ci-dessous
# (URL, base, secrets, Stripe live, mode staging DIGIT). Toute clé non listée : valeur du staging.

APP_NAME="PICHA Ticket"
APP_ENV=production
APP_KEY=<php artisan key:generate --show>
APP_DEBUG=false
APP_LOG_QUERIES=false
APP_URL=https://api.ticket.picha.fr
APP_PORT=8080
APP_FRONTEND_URL=https://ticket.picha.fr
APP_CDN_URL=https://api.ticket.picha.fr/storage
APP_PLATFORM_SUPPORT_EMAIL=<adresse support PICHA>
APP_DISABLE_REGISTRATION=<true si seuls les admins PICHA créent les comptes organisateurs>
APP_SAAS_MODE_ENABLED=<même valeur que le staging>
APP_SAAS_STRIPE_APPLICATION_FEE_PERCENT=<même valeur que le staging>
APP_STRIPE_CONNECT_ACCOUNT_TYPE=<même valeur que le staging>

CORS_ALLOWED_ORIGINS=https://ticket.picha.fr
SESSION_DOMAIN=ticket.picha.fr
SESSION_SECURE_COOKIE=true

LOG_CHANNEL=<valeur du staging>
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=picha_ticket_prod
DB_USERNAME=picha_prod
DB_PASSWORD=<identique à PROD_POSTGRES_PASSWORD du .env racine>

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
CACHE_DRIVER=<valeur du staging>
QUEUE_CONNECTION=<valeur du staging>
SESSION_DRIVER=<valeur du staging>

FILESYSTEM_PUBLIC_DISK=<valeur du staging>
FILESYSTEM_PRIVATE_DISK=<valeur du staging>

MAIL_MAILER=smtp
MAIL_HOST=<smtp>
MAIL_PORT=587
MAIL_USERNAME=<utilisateur smtp>
MAIL_PASSWORD=<mot de passe smtp>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=<noreply@ticket.picha.fr ou équivalent vérifié chez le fournisseur>
MAIL_FROM_NAME="PICHA Ticket"

# Clés Stripe LIVE (pk_live_/sk_live_) — jamais celles du staging.
STRIPE_PUBLIC_KEY=<pk_live_...>
STRIPE_SECRET_KEY=<sk_live_...>
STRIPE_WEBHOOK_SECRET=<whsec_... du webhook https://api.ticket.picha.fr/...>

JWT_SECRET=<php artisan jwt:secret --show, différent du staging>
JWT_ALGO=<valeur du staging>

DIGIT_SCAN_MODULE_ENABLED=<même valeur que le staging>
DIGIT_BRACELETS_MODULE_ENABLED=<même valeur que le staging>
DIGIT_SCAN_STAGING_MODE=false

# Copier vers frontend/.env.prod dans le dossier prod (/opt/picha-prod) puis remplir.
# Variables publiques uniquement : jamais de sk_live_/sk_test_/whsec_ ici.
# Méthode : partir de frontend/.env.staging, remplacer staging.ticket.picha.fr par ticket.picha.fr,
# api-staging.ticket.picha.fr par api.ticket.picha.fr (même chemin éventuel, ex. /api), et la clé pk_test_ par pk_live_.

VITE_FRONTEND_URL=https://ticket.picha.fr
VITE_API_URL_CLIENT=https://api.ticket.picha.fr<même chemin que le staging>
VITE_API_URL_SERVER=<valeur du staging, inchangée : nom de service Docker interne>
VITE_STRIPE_PUBLISHABLE_KEY=<pk_live_...>
VITE_APP_NAME="PICHA Ticket"
VITE_I_HAVE_PURCHASED_A_LICENCE=<même valeur que le staging>
VITE_APP_LOGO_DARK=<même valeur que le staging>
VITE_APP_LOGO_LIGHT=<même valeur que le staging>

# Copier en .env (jamais commité) puis remplir les valeurs « CHANGEZ-MOI ».
# Générer les secrets :
#   echo "base64:$(openssl rand -base64 32)"   -> APP_KEY
#   openssl rand -base64 32                   -> JWT_SECRET
#   openssl rand -hex 24                      -> POSTGRES_PASSWORD

# --- Application ---
APP_KEY=CHANGEZ-MOI
JWT_SECRET=CHANGEZ-MOI
APP_ENV=production
APP_DEBUG=false
LOG_CHANNEL=stderr
QUEUE_CONNECTION=redis
APP_FRONTEND_URL=https://ticket.picha.fr
APP_CDN_URL=https://ticket.picha.fr/storage
APP_DISABLE_REGISTRATION=false
APP_SAAS_MODE_ENABLED=false
APP_SAAS_STRIPE_APPLICATION_FEE_PERCENT=0
APP_SAAS_STRIPE_APPLICATION_FEE_FIXED=0
APP_EMAIL_LOGO_URL=https://ticket.picha.fr/logos/picha-email-logo.png
APP_EMAIL_LOGO_LINK_URL=https://ticket.picha.fr

# --- Frontend ---
VITE_APP_NAME="PICHA Ticket"
VITE_FRONTEND_URL=https://ticket.picha.fr
VITE_API_URL_CLIENT=https://ticket.picha.fr/api
VITE_API_URL_SERVER=http://localhost:80/api
VITE_I_HAVE_PURCHASED_A_LICENCE=true

# --- E-mails via Resend (SMTP) ---
# Domaine picha.fr à vérifier dans Resend (enregistrements DNS SPF/DKIM chez OVH).
MAIL_MAILER=smtp
MAIL_DRIVER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=resend
MAIL_PASSWORD=CHANGEZ-MOI-cle-api-resend
MAIL_FROM_ADDRESS=ticket@picha.fr
MAIL_FROM_NAME="PICHA Ticket"

# --- Fichiers ---
FILESYSTEM_PUBLIC_DISK=public
FILESYSTEM_PRIVATE_DISK=local

# --- Base de données ---
POSTGRES_DB=picha-ticket
POSTGRES_USER=picha
POSTGRES_PASSWORD=CHANGEZ-MOI

# --- Stripe (clés live pour encaisser en ligne) ---
STRIPE_PUBLIC_KEY=pk_live_CHANGEZ-MOI
STRIPE_SECRET_KEY=sk_live_CHANGEZ-MOI
STRIPE_WEBHOOK_SECRET=whsec_CHANGEZ-MOI
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_CHANGEZ-MOI

# À copier sur le VPS en backend/.env.production (jamais commité), puis remplir CHANGEZ-MOI.
#   APP_KEY    : echo "base64:$(openssl rand -base64 32)"
#   JWT_SECRET : openssl rand -base64 32
APP_NAME="PICHA Ticket"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://ticket.picha.fr/api
APP_FRONTEND_URL=https://ticket.picha.fr
APP_CDN_URL=https://ticket.picha.fr/api/storage
APP_LOCALE=fr
APP_KEY=CHANGEZ-MOI
JWT_SECRET=CHANGEZ-MOI
APP_DISABLE_REGISTRATION=false
APP_PLATFORM_SUPPORT_EMAIL=ticket@picha.fr
APP_EMAIL_LOGO_URL=https://ticket.picha.fr/logos/picha-email-logo.png

# Frais de plateforme : 0,99 € fixe par billet payant, prélevés via Stripe Connect (paiements carte en ligne).
APP_SAAS_MODE_ENABLED=true
APP_SAAS_STRIPE_APPLICATION_FEE_PERCENT=0
APP_SAAS_STRIPE_APPLICATION_FEE_FIXED=0.99

DATABASE_URL=postgresql://picha_ticket:CHANGEZ-MOI@postgres:5432/picha_ticket
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
CACHE_DRIVER=redis
SESSION_DRIVER=file

# CORS_ALLOWED_ORIGINS vaut * par défaut (widget, domaines personnalisés).
# Si on le restreint, garder capacitor://localhost pour l'app iPad PICHA Kiosk (D19d).

LOG_CHANNEL=stderr
LOG_LEVEL=warning

FILESYSTEM_DISK=local
FILESYSTEM_PRIVATE_DISK=local
FILESYSTEM_PUBLIC_DISK=public

# E-mails via Resend (domaine picha.fr vérifié dans Resend)
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=resend
MAIL_PASSWORD=CHANGEZ-MOI-cle-api-resend
MAIL_FROM_ADDRESS=ticket@picha.fr
MAIL_FROM_NAME="PICHA Ticket"

STRIPE_PUBLIC_KEY=pk_live_CHANGEZ-MOI
STRIPE_SECRET_KEY=sk_live_CHANGEZ-MOI
STRIPE_WEBHOOK_SECRET=whsec_CHANGEZ-MOI
